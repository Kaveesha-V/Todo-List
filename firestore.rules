rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Strict Per-User Task Isolation Rule
    // Every task document must have a userId matching the authenticated user's UID
    match /tasks/{taskId} {
      // Allow read, update, delete only if authenticated and the task belongs to the user
      allow read, update, delete: if request.auth != null && resource.data.userId == request.auth.uid;
      
      // Allow create only if authenticated and the new task specifies the user's UID
      allow create: if request.auth != null && request.resource.data.userId == request.auth.uid;
    }

    // User Profile Document Security
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }
  }
}
